<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/miku_device_info_card_margin_top">

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/miku_device_info_card_bg"
    android:clipToOutline="true"
    android:paddingStart="@dimen/miku_device_info_card_padding_start"
    android:paddingEnd="@dimen/miku_device_info_card_padding_end"
    android:paddingTop="@dimen/miku_device_info_card_padding_top"
    android:paddingBottom="@dimen/miku_device_info_card_padding_bottom">

    <!-- 关于手机.png: character 23% width, badge from 70% to the right edge. -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/miku_device_info_badge_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.70" />

    <LinearLayout
        android:id="@+id/miku_device_info_titles"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/miku_device_info_title_margin_start"
        android:gravity="start|top"
        android:orientation="vertical"
        app:layout_constraintEnd_toStartOf="@id/miku_device_info_badge_start"
        app:layout_constraintStart_toEndOf="@id/miku_device_info_character"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/miku_device_info_model_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/miku_device_info_title_margin_top"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/miku_device_info_model"
            android:textAppearance="@style/TextAppearance.MikuDeviceInfo.Title" />

        <TextView
            android:id="@+id/miku_device_info_model_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/miku_device_info_title_value_margin_top"
            android:ellipsize="end"
            android:lineHeight="@dimen/miku_device_info_title_value_line_height"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.MikuDeviceInfo.TitleValue" />

        <TextView
            android:id="@+id/miku_device_info_version_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/miku_device_info_version_label_margin_top"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/miku_device_info_version"
            android:textAppearance="@style/TextAppearance.MikuDeviceInfo.Title" />

        <TextView
            android:id="@+id/miku_device_info_version_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/miku_device_info_title_value_margin_top"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.MikuDeviceInfo.TitleValue" />
    </LinearLayout>

    <ImageView
        android:id="@+id/miku_device_info_character"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="4dp"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/miku_device_info_character"
        app:layout_constraintBottom_toBottomOf="@id/miku_device_info_titles"
        app:layout_constraintDimensionRatio="W,295:318"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/miku_device_info_titles" />

    <FrameLayout
        android:id="@+id/miku_device_info_build_type"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@id/miku_device_info_character"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/miku_device_info_badge_start">

        <ImageView
            android:id="@+id/miku_device_info_build_official"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitEnd"
            android:src="@drawable/miku_device_info_build_official"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/miku_device_info_build_community"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitEnd"
            android:src="@drawable/miku_device_info_build_community"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/miku_device_info_build_unofficial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitEnd"
            android:src="@drawable/miku_device_info_build_unofficial"
            android:visibility="visible" />
    </FrameLayout>

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/miku_device_info_top_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="miku_device_info_character,miku_device_info_titles,miku_device_info_build_type" />

    <GridLayout
        android:id="@+id/miku_device_info_specs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/miku_device_info_specs_margin_top"
        android:alignmentMode="alignBounds"
        android:columnCount="4"
        android:rowCount="2"
        android:useDefaultMargins="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/miku_device_info_top_barrier">

        <com.android.settings.widget.MikuDeviceInfoSpecItem
            android:id="@+id/miku_device_info_cpu"
            style="@style/Widget.MikuDeviceInfo.SpecItem"
            app:mikuSpecTitle="@string/miku_device_info_cpu" />

        <com.android.settings.widget.MikuDeviceInfoSpecItem
            android:id="@+id/miku_device_info_ram"
            style="@style/Widget.MikuDeviceInfo.SpecItem"
            app:mikuSpecTitle="@string/miku_device_info_ram" />

        <com.android.settings.widget.MikuDeviceInfoSpecItem
            android:id="@+id/miku_device_info_display"
            style="@style/Widget.MikuDeviceInfo.SpecItem"
            app:mikuSpecTitle="@string/miku_device_info_display" />

        <com.android.settings.widget.MikuDeviceInfoSpecItem
            android:id="@+id/miku_device_info_battery"
            style="@style/Widget.MikuDeviceInfo.SpecItem"
            app:mikuSpecTitle="@string/miku_device_info_battery" />

        <com.android.settings.widget.MikuDeviceInfoSpecItem
            android:id="@+id/miku_device_info_kernel"
            style="@style/Widget.MikuDeviceInfo.SpecItem.SecondRow"
            app:mikuSpecTitle="@string/miku_device_info_kernel" />

        <com.android.settings.widget.MikuDeviceInfoSpecItem
            android:id="@+id/miku_device_info_security"
            style="@style/Widget.MikuDeviceInfo.SpecItem.SecondRow"
            app:mikuSpecTitle="@string/miku_device_info_security" />

        <com.android.settings.widget.MikuDeviceInfoSpecItem
            android:id="@+id/miku_device_info_selinux"
            style="@style/Widget.MikuDeviceInfo.SpecItem.SecondRow"
            app:mikuSpecTitle="@string/miku_device_info_selinux" />

        <com.android.settings.widget.MikuDeviceInfoSpecItem
            android:id="@+id/miku_device_info_maintainer"
            style="@style/Widget.MikuDeviceInfo.SpecItem.SecondRow"
            app:mikuSpecTitle="@string/miku_device_info_maintainer" />
    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
